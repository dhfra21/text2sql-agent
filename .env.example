# Copy this file to .env and fill in your values — never commit .env

GROQ_API_KEY=your_groq_api_key   # free at console.groq.com
GROQ_MODEL=openai/gpt-oss-120b   # any Groq chat model with tool-use support

GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_REGION=europe-west1

# PostgreSQL (local dev)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=text2sql_dev
DB_USER=postgres
DB_PASSWORD=your_db_password
