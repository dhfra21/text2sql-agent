# Streamlit Community Cloud secrets template.
# Copy these keys into the app's "Secrets" box in the Streamlit Cloud dashboard
# (Settings -> Secrets). Do NOT commit the real .streamlit/secrets.toml file.

GROQ_API_KEY = "gsk_your_key_here"
GROQ_MODEL   = "openai/gpt-oss-120b"
GROQ_FALLBACK_MODELS = "openai/gpt-oss-20b,qwen/qwen3.8-27b"

# Neon (or other managed) Postgres — from your Neon connection details.
DB_HOST     = "ep-xxxx-xxxx.eu-central-1.aws.neon.tech"
DB_PORT     = "5432"
DB_NAME     = "text2sql_dev"
DB_USER     = "your_neon_user"
DB_PASSWORD = "your_neon_password"
DB_SSLMODE  = "require"
